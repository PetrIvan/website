{
	"name": "website",
	"private": true,
	"version": "0.0.1",
	"description": "Personal website and blog for Petr Ivan.",
	"homepage": "https://petrivan.com",
	"repository": {
		"type": "git",
		"url": "https://github.com/PetrIvan/website.git"
	},
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@10.17.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "vite dev",
		"prebuild": "pnpm run social-card:build",
		"build": "vite build",
		"preview": "vite preview",
		"social-card:build": "node scripts/generate-social-card.mjs",
		"skills:validate": "node scripts/validate-skills.mjs",
		"resume:build": "typst compile --creation-timestamp 0 --font-path resume/fonts resume/resume.typ static/petr-ivan-resume.pdf",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test:e2e": "pnpm run build && playwright test",
		"test:visual": "pnpm run build && playwright test --config playwright.visual.config.ts",
		"test": "vitest run",
		"validate": "pnpm run lint && pnpm run skills:validate && pnpm run check && pnpm run test && pnpm run test:e2e"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.0",
		"@resvg/resvg-js": "2.6.2",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/enhanced-img": "^0.11.0",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"mdsvex": "^0.12.8",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"remark-footnotes": "2.0.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@fluentui/svg-icons": "^1.1.333",
		"@fontsource-variable/figtree": "^5.2.10"
	},
	"pnpm": {
		"overrides": {
			"brace-expansion@<=5.0.7": "5.0.8",
			"cookie@<0.7.0": "0.7.2",
			"sharp@<0.35.0": "0.35.3"
		}
	}
}
